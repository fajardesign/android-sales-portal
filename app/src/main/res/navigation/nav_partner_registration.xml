<?xml version="1.0" encoding="utf-8"?>
<!-- Partner Registration, assisted by TL/SR (PRD v3 C2; spec: okf_repository_design/.../flows_android/partner_registration.md;
     screens: Figma "Sales - Partner Dashboard - Android"). Nested in nav_main; one destination per Flow ID; the ViewModel is
     scoped to this graph. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_partner_registration"
    app:startDestination="@id/reg02_partner_info">

    <fragment
        android:id="@+id/reg02_partner_info"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegPartnerInfoFragment">
        <action android:id="@+id/action_reg02_to_reg03" app:destination="@id/reg03_business" />
    </fragment>

    <fragment
        android:id="@+id/reg03_business"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegBusinessFragment">
        <action android:id="@+id/action_reg03_to_reg04" app:destination="@id/reg04_pic" />
    </fragment>

    <fragment
        android:id="@+id/reg04_pic"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegPicFragment">
        <action android:id="@+id/action_reg04_to_reg05" app:destination="@id/reg05_bank_account" />
    </fragment>

    <fragment
        android:id="@+id/reg05_bank_account"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegBankAccountFragment">
        <action android:id="@+id/action_reg05_to_reg06" app:destination="@id/reg06_documents" />
    </fragment>

    <fragment
        android:id="@+id/reg06_documents"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegDocumentsFragment">
        <action android:id="@+id/action_reg06_to_reg07" app:destination="@id/reg07_review" />
    </fragment>

    <fragment
        android:id="@+id/reg07_review"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegReviewFragment">
        <action android:id="@+id/action_reg07_to_reg08" app:destination="@id/reg08_location" />
    </fragment>

    <fragment
        android:id="@+id/reg08_location"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegLocationFragment">
        <!-- After submitting, the steps leave the back stack; the graph (and its ViewModel) stays with the success screen. -->
        <action
            android:id="@+id/action_reg08_to_success"
            app:destination="@id/reg09_success"
            app:popUpTo="@id/reg02_partner_info"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_reg08_to_consent" app:destination="@id/reg12_consent" />
    </fragment>

    <fragment
        android:id="@+id/reg12_consent"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegConsentFragment" />

    <fragment
        android:id="@+id/reg09_success"
        android:name="com.example.and_sales_portal.ui.partnerregistration.RegSuccessFragment" />
</navigation>
