<?xml version="1.0" encoding="utf-8"?>
<!-- Sales app (TL, SR, SA): splash (MLG-00), login (MLG-01) and the bottom navigation tabs per role (PRD v3). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/splash">

    <fragment android:id="@+id/splash" android:name="com.example.and_sales_portal.ui.auth.SplashFragment" />
    <fragment android:id="@+id/login" android:name="com.example.and_sales_portal.ui.auth.LoginFragment" />

    <fragment android:id="@+id/tl_home" android:name="com.example.and_sales_portal.ui.dashboard.TlHomeFragment" />
    <fragment android:id="@+id/sales_home" android:name="com.example.and_sales_portal.ui.dashboard.SalesHomeFragment" />
    <fragment android:id="@+id/partner_tab" android:name="com.example.and_sales_portal.ui.partner.PartnerTabFragment" />
    <!-- Performa (PRD Scope 3, PRF-01 … PRF-05): TL tab with Pipeline, Penghasilan, Tim; SA/SR tab with Pipeline, Penghasilan, Produktivitas. -->
    <fragment android:id="@+id/tl_performance_tab" android:name="com.example.and_sales_portal.ui.performance.TlPerformanceTabFragment" />
    <fragment android:id="@+id/activity_tab" android:name="com.example.and_sales_portal.ui.shell.ActivityTabFragment" />
    <fragment android:id="@+id/visits_tab" android:name="com.example.and_sales_portal.ui.visits.VisitsTabFragment" />
    <fragment android:id="@+id/performance_tab" android:name="com.example.and_sales_portal.ui.performance.SalesPerformanceTabFragment" />
    <!-- Spec: PRF-03 Detail Pinjaman, PRF-04 detail bulan, PRF-04 Penghasilan SA/SR dilihat TL (read-only). -->
    <fragment android:id="@+id/loan_detail" android:name="com.example.and_sales_portal.ui.performance.LoanDetailFragment" />
    <fragment android:id="@+id/income_month" android:name="com.example.and_sales_portal.ui.performance.IncomeMonthFragment" />
    <fragment android:id="@+id/member_income" android:name="com.example.and_sales_portal.ui.performance.MemberIncomeFragment" />
    <fragment android:id="@+id/account_tab" android:name="com.example.and_sales_portal.ui.shell.AccountFragment" />

    <!-- Absensi & Kunjungan (ATT-01 … ATT-05, PRD v3 D2, D3, C8). -->
    <fragment android:id="@+id/attendance" android:name="com.example.and_sales_portal.ui.attendance.AttendanceFragment" />
    <fragment android:id="@+id/capture" android:name="com.example.and_sales_portal.ui.attendance.CaptureFragment" />
    <fragment android:id="@+id/notifications" android:name="com.example.and_sales_portal.ui.notifications.NotificationsFragment" />
    <fragment android:id="@+id/my_visits" android:name="com.example.and_sales_portal.ui.visits.MyVisitsFragment" />
    <fragment android:id="@+id/visit_detail" android:name="com.example.and_sales_portal.ui.visits.VisitDetailFragment" />
    <fragment android:id="@+id/visit_checkout" android:name="com.example.and_sales_portal.ui.visits.VisitCheckOutFragment" />

    <!-- Partner (REG-01, REG-10, REG-11, PRT-01, PRT-02; PRD v3 C2-C4, D4) and the registration flow. -->
    <include app:graph="@navigation/nav_partner_registration" />
    <fragment android:id="@+id/submission_detail" android:name="com.example.and_sales_portal.ui.partner.SubmissionDetailFragment" />
    <fragment android:id="@+id/revision" android:name="com.example.and_sales_portal.ui.partner.RevisionFragment" />
    <fragment android:id="@+id/partner_detail" android:name="com.example.and_sales_portal.ui.partner.PartnerDetailFragment" />
    <fragment android:id="@+id/add_store" android:name="com.example.and_sales_portal.ui.partner.AddStoreFragment" />

    <!-- Tim, Assign SA/SR, Jadwal Kunjungan (TL-01 … TL-05; PRD v3 C5-C7). -->
    <fragment android:id="@+id/team_detail" android:name="com.example.and_sales_portal.ui.team.MemberDetailFragment" />
    <fragment android:id="@+id/assign" android:name="com.example.and_sales_portal.ui.team.AssignFragment" />
    <fragment android:id="@+id/schedule" android:name="com.example.and_sales_portal.ui.team.ScheduleFragment" />

    <!-- Laporan TL (TL-07; TL-08 … TL-10 replaced by Performa, PRD Scope 3). -->
    <fragment android:id="@+id/team_productivity" android:name="com.example.and_sales_portal.ui.dashboard.TeamProductivityFragment" />
    <fragment android:id="@+id/evidence" android:name="com.example.and_sales_portal.ui.dashboard.EvidenceFragment" />
    <!-- Spec: TL-11 Koreksi Absensi (decision 2026-10-19). -->
    <fragment android:id="@+id/attendance_correction" android:name="com.example.and_sales_portal.ui.team.AttendanceCorrectionFragment" />

    <!-- Debug simulation panel. -->
    <fragment android:id="@+id/simulation" android:name="com.example.and_sales_portal.ui.simulation.SimulationFragment" />
</navigation>
